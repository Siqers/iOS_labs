                                        <rect key="frame" x="0" y="482" width="345" height="48" />
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" />
                                        <buttonConfiguration key="configuration" style="filled" cornerStyle="medium" title="Show another trail">
                                            <color key="baseBackgroundColor" red="0.1411764705882353" green="0.36470588235294116" blue="0.33725490196078434" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                                        </buttonConfiguration>
                                        <connections>
                                            <action selector="spin:" destination="main" eventType="touchUpInside" id="lab-012-id" />
                                        </connections>
                                    </button>
                                </subviews>
