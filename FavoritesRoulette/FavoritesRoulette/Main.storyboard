                                        <rect key="frame" x="0" y="294" width="345" height="58" />
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" />
                                        <color key="textColor" systemColor="labelColor" />
                                        <fontDescription key="fontDescription" type="system" pointSize="23" weight="semibold" />
                                    </label>
                                    <label id="lab-007-id" text="The trail follows the river into the gorge. Spruce trees shade the early stretch. The peaks come into view as the valley opens." textAlignment="center" numberOfLines="0" lineBreakMode="wordWrap">
                                        <rect key="frame" x="0" y="358" width="345" height="106" />
                                        <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES" />
                                        <color key="textColor" systemColor="secondaryLabelColor" />
