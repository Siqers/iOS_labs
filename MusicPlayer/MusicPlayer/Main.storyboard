                        <outlet property="coverView" destination="lab-007-id" id="lab-020-id"/>
                        <outlet property="playButton" destination="lab-016-id" id="lab-023-id"/>
                        <outlet property="titleLabel" destination="lab-010-id" id="lab-021-id"/>
