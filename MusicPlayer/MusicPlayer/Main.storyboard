                            <constraint firstItem="lab-003-id" firstAttribute="trailing" secondItem="lab-002-id-safe" secondAttribute="trailing" constant="-20" id="lab-005-id"/>
                            <constraint firstItem="lab-003-id" firstAttribute="centerY" secondItem="lab-002-id-safe" secondAttribute="centerY" id="lab-006-id"/>
